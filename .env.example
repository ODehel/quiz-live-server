# Modèle du .env : copier en .env (non versionné), puis remplacer chaque valeur
# Secret de signature des tokens du hub : obligatoire, 32 caractères minimum. Laissé vide, le hub refuse de démarrer.
JWT_SECRET=
SEED_PASSWORD_ADMIN=<a_changer>
SEED_PASSWORD_BUZZER_01=<a_changer>
SEED_PASSWORD_BUZZER_02=<a_changer>
SEED_PASSWORD_BUZZER_03=<a_changer>
SEED_PASSWORD_BUZZER_04=<a_changer>
SEED_PASSWORD_BUZZER_05=<a_changer>
SEED_PASSWORD_BUZZER_06=<a_changer>
SEED_PASSWORD_BUZZER_07=<a_changer>
SEED_PASSWORD_BUZZER_08=<a_changer>
SEED_PASSWORD_BUZZER_09=<a_changer>
SEED_PASSWORD_BUZZER_10=<a_changer>

# Facultatives : à décommenter seulement pour changer la valeur par défaut. Ne jamais les écrire avec une valeur vide.
# Durée de validité d'un token, en secondes : entier strictement positif, chiffres seulement. Absente ou vide : 3600.
# JWT_EXPIRATION=3600
# Facteur de coût bcrypt : entier de 4 à 31, chiffres seulement, sans zéro en tête.
# BCRYPT_COST=12
# Chemin du fichier SQLite : non vide, pas uniquement des blancs.
# SQLITE_DB_PATH=quiz.db
